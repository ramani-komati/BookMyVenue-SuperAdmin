# Base URL of the BookMyVenues admin API (no trailing slash).
# OPTIONAL. Leave unset for local dev: adminApi.js defaults to /api/admin, which
# the Vite dev proxy forwards to the backend (sidestepping the CORS lockdown on
# localhost). Production builds default to the onrender URL automatically.
# Set this only to override the target (e.g. point dev at a local backend).
# VITE_ADMIN_API_BASE=https://bookmyvenues-backend.onrender.com/api/admin

# ---------------------------------------------------------------------------
# Dev proxy target (vite.config.js) — OPTIONAL, and NOT needed as a file.
# Read from the command line too, so a one-off override needs no second file:
#
#   # PowerShell
#   $env:VITE_DEV_PROXY_TARGET="http://127.0.0.1:8000"; npm run dev
#   # bash
#   VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000 npm run dev
#
# Unset = the deployed backend. Point it at a local backend to use the admin
# Events management, which the deployed backend does not serve yet.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
